# ==============================================================================
# PORTFOLIO ENVIRONMENT VARIABLES FOR VERCEL DEPLOYMENT
# ==============================================================================
# Configure AT LEAST ONE of the following 3 options in Vercel Project Settings.
# The serverless function (/api/contact.js) will automatically detect which one is set.

# ------------------------------------------------------------------------------
# OPTION 1: Resend (RECOMMENDED for Vercel)
# 1. Sign up at https://resend.com
# 2. Get an API Key from your Resend dashboard
# 3. Paste the API key below
# ------------------------------------------------------------------------------
RESEND_API_KEY=re_1234567890abcdef

# ------------------------------------------------------------------------------
# OPTION 2: Web3Forms
# 1. Go to https://web3forms.com
# 2. Enter your Gmail address (nagaramsaiteja57@gmail.com) to get an Access Key
# 3. Paste the Access Key below
# ------------------------------------------------------------------------------
WEB3FORMS_ACCESS_KEY=your_web3forms_access_key_here

# ------------------------------------------------------------------------------
# OPTION 3: Gmail SMTP (Nodemailer)
# 1. Go to Google Account > Security > 2-Step Verification > App Passwords
# 2. Generate an App Password for "Mail"
# 3. Paste your Gmail address and 16-character App Password below
# ------------------------------------------------------------------------------
GMAIL_USER=nagaramsaiteja57@gmail.com
GMAIL_APP_PASSWORD=your_16_digit_app_password_here

# ------------------------------------------------------------------------------
# DESTINATION EMAIL ADDRESS (Optional - defaults to nagaramsaiteja57@gmail.com)
# ------------------------------------------------------------------------------
TO_EMAIL=nagaramsaiteja57@gmail.com
